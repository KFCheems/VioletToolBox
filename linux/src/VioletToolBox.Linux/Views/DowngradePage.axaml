<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             x:Class="VioletToolBox.Linux.Views.DowngradePage"
             x:DataType="vm:DowngradePageViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="降级助手 · ColorOS" Classes="h1" Margin="0" />
        <TextBlock Text="OPPO / 一加设备 OTA 降级包查询、下载与推送执行" Classes="muted" />
      </StackPanel>
    </Grid>

    <Border Classes="panel" MaxWidth="900" HorizontalAlignment="Left">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding AssistantApk}" PlaceholderText="ColorOS 助手 APK（可选）" IsReadOnly="True" />
          <Button Grid.Column="1" Content="浏览" Command="{Binding PickApkCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding DownloadDir}" PlaceholderText="下载目录（留空=~/Downloads）" />
          <Button Grid.Column="1" Content="浏览" Command="{Binding PickDirCommand}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <CheckBox Content="仅查询降级包（不执行）" IsChecked="{Binding QueryOnly}" />
          <Button Classes="primary" Content="运行降级工具" Command="{Binding RunCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Packages}" MaxHeight="240">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DowngradePageViewModel">
              <TextBlock Text="—" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" />
        <TextBlock Text="{Binding Status}" FontSize="13" Foreground="#4E4A5C" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
