<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             x:Class="VioletToolBox.Linux.Views.DowngradePage"
             x:DataType="vm:DowngradePageViewModel">
  <StackPanel>
    <TextBlock Text="降级助手（OPPO / 一加）" Classes="h1" />

    <Border Classes="card" MaxWidth="900" HorizontalAlignment="Left">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding AssistantApk}" PlaceholderText="ColorOS 助手 APK（可选）" IsReadOnly="True" />
          <Button Grid.Column="1" Content="浏览…" Command="{Binding PickApkCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding DownloadDir}" PlaceholderText="下载目录（留空=~/Downloads）" />
          <Button Grid.Column="1" Content="浏览…" Command="{Binding PickDirCommand}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <CheckBox Content="仅查询降级包（不执行）" IsChecked="{Binding QueryOnly}" />
          <Button Classes="violet" Content="运行降级工具" Command="{Binding RunCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Packages}" MaxHeight="240">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DowngradePageViewModel">
              <TextBlock Text="—" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" />
        <TextBlock Text="{Binding Status}" FontSize="12.5" Foreground="#B7AFCE" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
