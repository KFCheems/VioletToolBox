<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             x:Class="VioletToolBox.Linux.Views.GenericPage"
             x:DataType="vm:GenericPageViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="安卓通用工具集" Classes="h1" Margin="0" />
        <TextBlock Text="卡刷转线刷、TWRP 引导、OCDT 分析、ADB 修复与无线调试" Classes="muted" />
      </StackPanel>
    </Grid>

    <Border Classes="panel" MaxWidth="860" HorizontalAlignment="Left">
      <StackPanel Spacing="10">
        <TextBlock Text="卡刷转线刷（zip → 解包 + payload 展开 + flash 脚本）" FontWeight="Medium" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding ZipPath}" PlaceholderText="卡刷包 zip 路径" />
          <Button Grid.Column="1" Content="浏览…" Command="{Binding PickZipCommand}" />
        </Grid>
        <TextBox Text="{Binding OutputDir}" PlaceholderText="输出目录（留空=zip 同名目录）" />
        <Button Classes="primary" Content="转换" Command="{Binding ConvertCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <Border Classes="panel" MaxWidth="860" HorizontalAlignment="Left">
      <StackPanel Spacing="10">
        <TextBlock Text="其他工具" FontWeight="Medium" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding TwrpImg}" PlaceholderText="TWRP recovery.img（临时引导）" />
          <Button Grid.Column="1" Content="浏览…" />
          <Button Grid.Column="2" Content="fastboot boot" Command="{Binding BootTwrpCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding OcdtPath}" PlaceholderText="OCDT 文件（OPLUS 分析）" />
          <Button Grid.Column="1" Content="浏览…" Command="{Binding PickOcdtCommand}" />
          <Button Grid.Column="2" Content="OCDT 分析" Command="{Binding AnalyzeOcdtCommand}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding WirelessAddr}" PlaceholderText="无线调试 IP:端口（adb connect）" />
          <Button Grid.Column="1" Content="连接" Command="{Binding WirelessConnectCommand}" />
        </Grid>
        <Button Content="修复 ADB（重启 adb server）" Command="{Binding FixAdbCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Status}" FontSize="12.5" Foreground="#5C5670" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
