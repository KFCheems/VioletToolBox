<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             x:Class="VioletToolBox.Linux.Views.FlashPage"
             x:DataType="vm:FlashPageViewModel">

  <StackPanel Spacing="0">

    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="基本镜像刷入" Classes="h1" Margin="0" />
        <TextBlock Text="支持针对 boot、init_boot、dtbo、recovery、vbmeta 等常规分区的极速刷写与安全擦除" Classes="muted" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="16">

      <!-- Left Column: Flash Form -->
      <Border Grid.Column="0" Classes="card">
        <StackPanel Spacing="16">

          <!-- File selector -->
          <StackPanel Spacing="6">
            <TextBlock Text="目标镜像文件 (.img / .bin)" FontWeight="SemiBold" FontSize="13" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0" Text="{Binding ImagePath}" PlaceholderText="点击右侧浏览选择本地镜像文件路径..." />
              <Button Grid.Column="1" Content="📁 浏览文件..." Command="{Binding BrowseCommand}" Padding="14,8" />
            </Grid>
          </StackPanel>

          <!-- Partition target -->
          <StackPanel Spacing="6">
            <TextBlock Text="选择目标刷写分区" FontWeight="SemiBold" FontSize="13" />
            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="预设常规分区" Classes="muted" FontSize="11" />
                <ComboBox ItemsSource="{Binding PartitionOptions}"
                          SelectedItem="{Binding SelectedPartition}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="或者输入自定义分区名" Classes="muted" FontSize="11" />
                <TextBox Text="{Binding CustomPartition}" PlaceholderText="如: boot_a / abl_b" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- Security Flags -->
          <Border Classes="card-subtle">
            <StackPanel Spacing="6">
              <CheckBox Content="附加禁用 AVB 校验 (--disable-verity --disable-verification)"
                        IsChecked="{Binding DisableVerity}" FontWeight="Medium" />
              <TextBlock Text="* 刷入自定义 vbmeta 时勾选此项，可避免开机 DM-Verity 验证失败卡开机循环 (Bootloop)"
                         Classes="muted" FontSize="11" Margin="28,0,0,0" />
            </StackPanel>
          </Border>

          <!-- Action Buttons -->
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="12">
              <Button Grid.Column="0" Classes="violet" Content="⚡ 开始刷入分区"
                      Command="{Binding FlashCommand}" HorizontalAlignment="Stretch" Padding="0,12" FontSize="14" />
              <Button Grid.Column="1" Classes="danger" Content="⚠️ 擦除目标分区"
                      Command="{Binding EraseCommand}" HorizontalAlignment="Stretch" Padding="0,12" FontSize="13" />
            </Grid>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#C4B5FD" FontSize="12.5" />
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- Right Column: Operations Guide & Notice -->
      <StackPanel Grid.Column="1" Spacing="16">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="💡 刷入说明与机制" Classes="h2" Margin="0" />
            <TextBlock Text="1. 通信调度机制：" FontWeight="SemiBold" Foreground="#DDD6FE" />
            <TextBlock Text="   • 检测到 Fastboot 设备时，优先采用 fastboot flash 指令直接刷入。" Classes="muted" />
            <TextBlock Text="   • 在开机系统模式下，工具将自动请求 ADB Root 并使用 dd 块级别写入。" Classes="muted" />

            <Separator Background="{DynamicResource BorderMutedBrush}" Height="1" />

            <TextBlock Text="2. 常见问题排查：" FontWeight="SemiBold" Foreground="#DDD6FE" />
            <TextBlock Text="   • 刷入 boot / init_boot 请务必确认与当前系统版本基线一致。" Classes="muted" />
            <TextBlock Text="   • A/B 分区设备如果未指定后缀，Fastboot 将写入当前活动槽位 (Active Slot)。" Classes="muted" />
            <TextBlock Text="   • 若提示 No such partition，请检查分区名称或进入 FastbootD 模式刷写动态分区。" Classes="muted" />
          </StackPanel>
        </Border>
      </StackPanel>

    </Grid>

  </StackPanel>
</UserControl>
