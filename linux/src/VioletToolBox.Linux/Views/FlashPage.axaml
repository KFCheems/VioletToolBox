<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             x:Class="VioletToolBox.Linux.Views.FlashPage"
             x:DataType="vm:FlashPageViewModel">

  <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">

    <!-- Left column (upstream layout): 常规操作刷入 / 小米官方线刷 -->
    <StackPanel Grid.Column="0" Spacing="12">

      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Text="常规操作刷入" Classes="h2" Margin="0" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="分区:" VerticalAlignment="Center" FontSize="12.5" />
            <ComboBox ItemsSource="{Binding PartitionOptions}" SelectedItem="{Binding SelectedPartition}"
                      MinWidth="160" />
            <TextBox Text="{Binding CustomPartition}" PlaceholderText="自定义分区" MinWidth="130" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding ImagePath}" PlaceholderText="请选择需要刷入的文件..." />
            <Button Grid.Column="1" Content="📁 选择" Command="{Binding BrowseCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="开始刷入" Command="{Binding FlashCommand}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox Content="自动重启" IsChecked="{Binding AutoReboot}" />
            <CheckBox Content="等待FB设备" IsChecked="{Binding WaitForFastboot}" />
            <CheckBox Content="禁用DM校验" IsChecked="{Binding DisableVerity}" />
          </StackPanel>
          <Button Classes="danger" Content="擦除分区" Command="{Binding EraseCommand}"
                  HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C5670" FontSize="12.5" />
        </StackPanel>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Text="小米官方线刷" Classes="h2" Margin="0" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding XiaomiDir}"
                     PlaceholderText="请选择一个解压好的刷机包文件..." />
            <Button Grid.Column="1" Content="📁 选择" Command="{Binding PickXiaomiDirCommand}" />
            <Button Grid.Column="2" Classes="primary" Content="开始线刷" Command="{Binding RunXiaomiCommand}" />
          </Grid>
          <ComboBox ItemsSource="{Binding XiaomiScripts}" SelectedItem="{Binding XiaomiScript}"
                    HorizontalAlignment="Left" MinWidth="260" />
        </StackPanel>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Text="Bootloader 操作" Classes="h2" Margin="0" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox SelectedItem="{Binding BlCommand}" HorizontalAlignment="Left" MinWidth="220">
              <ComboBoxItem Content="fastboot flashing unlock" />
              <ComboBoxItem Content="fastboot oem unlock" />
              <ComboBoxItem Content="fastboot flashing lock" />
              <ComboBoxItem Content="fastboot oem lock" />
            </ComboBox>
            <Button Grid.Column="1" Classes="primary" Content="执行指令" Command="{Binding RunBlCommand}" />
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>

    <!-- Right column: 扩展功能 (upstream: 8 buttons, 2 columns) + log -->
    <StackPanel Grid.Column="1" Spacing="12">

      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Text="扩展功能" Classes="h2" Margin="0" />
          <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
            <Button Grid.Column="0" Content="格式化设备【双清】" Margin="0,0,0,8" Command="{Binding FormatDeviceCommand}" />
            <Button Grid.Column="1" Content="擦除谷歌锁" Margin="0,0,0,8" Command="{Binding WipeFrpCommand}" />
            <Button Grid.Column="0" Grid.Row="1" Content="修复ADB异常" Margin="0,0,0,8" Command="{Binding FixAdbCommand}" />
            <Button Grid.Column="1" Grid.Row="1" Content="强开小米USB安全设置" Margin="0,0,0,8" Command="{Binding MiUsbCommand}" />
            <Button Grid.Column="0" Grid.Row="2" Content="ADB读取DDR版本" Margin="0,0,0,8" Command="{Binding ReadDdrCommand}" />
            <Button Grid.Column="1" Grid.Row="2" Content="ADB强开基带调试端口" Margin="0,0,0,8" Command="{Binding DiagCommand}" />
            <Button Grid.Column="0" Grid.Row="3" Content="ADB切换文件传输" Margin="0,0,0,8" Command="{Binding MtpCommand}" />
            <Button Grid.Column="1" Grid.Row="3" Content="欧加真OCDT分析" Margin="0,0,0,8" Command="{Binding OcdtCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" MinHeight="220">
        <StackPanel Spacing="8">
          <TextBlock Text="执行日志" Classes="h2" Margin="0" />
          <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   Background="#FAFAFD" BorderThickness="0" MinHeight="180" FontSize="12"
                   Foreground="#44405A"
                   FontFamily="JetBrains Mono, Noto Sans Mono CJK SC, monospace" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding SpeedText}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Percent, StringFormat={}{0:F0}%}"
                       Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold" />
          </Grid>
          <ProgressBar Value="{Binding Percent}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </Grid>
</UserControl>
