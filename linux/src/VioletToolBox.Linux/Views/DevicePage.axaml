<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             xmlns:core="using:VioletToolBox.Core.Android"
             x:Class="VioletToolBox.Linux.Views.DevicePage"
             x:DataType="vm:DevicePageViewModel">

  <StackPanel Spacing="0">

    <!-- Header bar -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="设备连接与主页" Classes="h1" Margin="0" />
        <TextBlock Text="识别已连接的 Android 设备，执行快速重启、槽位调度与环境依赖诊断" Classes="muted" />
      </StackPanel>
      <Button Grid.Column="1" Classes="violet" Content="⚡ 刷新设备" Command="{Binding RefreshCommand}"
              VerticalAlignment="Center" Padding="18,10" />
    </Grid>

    <Grid ColumnDefinitions="1.1*,1*" ColumnSpacing="16">

      <!-- Left Column: Device Detection & Fast Controls -->
      <StackPanel Grid.Column="0" Spacing="16">

        <!-- Online Devices Status Card -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="已识别连接" Classes="h2" Margin="0" />
              <Border Grid.Column="1" Background="#261A47" CornerRadius="6" Padding="8,3">
                <TextBlock Text="{Binding AdbSummary}" FontSize="11" Foreground="#C4B5FD" />
              </Border>
            </Grid>

            <!-- ADB Device List -->
            <StackPanel Spacing="4">
              <TextBlock Text="ADB 设备 (开机/系统模式):" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
              <Border Classes="card-subtle" MinHeight="68">
                <ListBox ItemsSource="{Binding AdbDevices}" SelectedItem="{Binding SelectedAdbDevice}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:AdbDevice">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="📱" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                          <TextBlock Text="{Binding Serial}" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="#163828" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding State}" Foreground="#34D399" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </StackPanel>

            <!-- Fastboot Device List -->
            <StackPanel Spacing="4">
              <TextBlock Text="Fastboot 设备 (Bootloader / FastbootD):" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
              <Border Classes="card-subtle" MinHeight="48">
                <ListBox ItemsSource="{Binding FastbootDevices}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:FastbootDevice">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="⚡" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#F59E0B" />
                        <TextBlock Grid.Column="1" Text="{Binding Serial}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="#3D2914" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding State}" Foreground="#FBBF24" FontSize="11" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Quick Reboot & Slot Controls -->
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Text="快捷重启调度" Classes="h2" Margin="0" />
            <TextBlock Text="向目标设备发送标准 Boot 指令：" Classes="muted" />

            <WrapPanel Orientation="Horizontal">
              <Button Content="系统正常重启" Margin="0,0,8,8" Command="{Binding RebootCommand}" CommandParameter="" />
              <Button Content="进入 Recovery" Margin="0,0,8,8" Command="{Binding RebootCommand}" CommandParameter="recovery" />
              <Button Content="Bootloader (Fastboot)" Margin="0,0,8,8" Command="{Binding RebootCommand}" CommandParameter="bootloader" />
              <Button Content="FastbootD (用户空间)" Margin="0,0,8,8" Command="{Binding RebootCommand}" CommandParameter="fastbootd" />
              <Button Content="进入 Sideload" Margin="0,0,8,8" Command="{Binding RebootCommand}" CommandParameter="sideload" />
              <Button Content="高通 9008 (EDL)" Margin="0,0,8,8" Classes="danger" Command="{Binding RebootCommand}" CommandParameter="edl" />
            </WrapPanel>

            <Separator Background="{DynamicResource BorderMutedBrush}" Height="1" Margin="0,4" />

            <TextBlock Text="A/B 动态槽位切换 (需 Fastboot 模式)" Classes="h2" Margin="0" />
            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
              <Button Grid.Column="0" Classes="violet" Content="切换到槽位 A (Active A)" HorizontalAlignment="Stretch"
                      Command="{Binding SetSlotCommand}" CommandParameter="a" />
              <Button Grid.Column="1" Classes="violet" Content="切换到槽位 B (Active B)" HorizontalAlignment="Stretch"
                      Command="{Binding SetSlotCommand}" CommandParameter="b" />
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>

      <!-- Right Column: Specs & Diagnostic Tools -->
      <StackPanel Grid.Column="1" Spacing="16">

        <!-- Device Info Card -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="设备属性与状态摘要" Classes="h2" Margin="0" />
            <TextBox Text="{Binding DeviceInfo}" IsReadOnly="True" AcceptsReturn="True"
                     Background="#110E1E" BorderBrush="{DynamicResource BorderMutedBrush}"
                     BorderThickness="1" MinHeight="170" CornerRadius="8"
                     TextWrapping="Wrap" FontSize="12.5" Foreground="#E2DCF5"
                     FontFamily="JetBrains Mono, Noto Sans Mono CJK SC, monospace" />
          </StackPanel>
        </Border>

        <!-- Tools Diagnostics Card -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="系统工具链健康检查" Classes="h2" Margin="0" />
              <TextBlock Grid.Column="1" Text="自动探测" Classes="muted" />
            </Grid>

            <Border Classes="card-subtle" Padding="12">
              <ScrollViewer MaxHeight="220">
                <ItemsControl ItemsSource="{Binding Tools}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolStatus">
                      <Grid ColumnDefinitions="100,*" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="#A78BFA" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="11.5" Foreground="{DynamicResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>

    </Grid>

  </StackPanel>
</UserControl>
