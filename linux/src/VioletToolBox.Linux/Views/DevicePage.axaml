<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             xmlns:core="using:VioletToolBox.Core.Android"
             x:Class="VioletToolBox.Linux.Views.DevicePage"
             x:DataType="vm:DevicePageViewModel">

  <StackPanel Spacing="12">

    <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="12">

      <!-- 设备信息 (upstream: two-column field card) -->
      <Border Grid.Column="0" Classes="panel">
        <StackPanel Spacing="6">
          <TextBlock Text="设备信息" Classes="h2" Margin="0" />
          <Grid ColumnDefinitions="Auto,10,Auto,12,Auto,10,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" >
            <TextBlock Grid.Row="0" Grid.Column="0" Text="设备状态:" Classes="muted" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DeviceStatus}" Foreground="{DynamicResource DangerBrush}" FontWeight="Medium" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="连接类型:" Classes="muted" />
            <TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding ConnectionType}" Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="设备序列号:" Classes="muted" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Serial}" />
            <TextBlock Grid.Row="1" Grid.Column="4" Text="设备名称:" Classes="muted" />
            <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding Model}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="设备代号:" Classes="muted" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DeviceCode}" />
            <TextBlock Grid.Row="2" Grid.Column="4" Text="安卓版本:" Classes="muted" />
            <TextBlock Grid.Row="2" Grid.Column="6" Text="{Binding AndroidVersion}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="解锁状态:" Classes="muted" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding UnlockState}" />
            <TextBlock Grid.Row="3" Grid.Column="4" Text="版本信息:" Classes="muted" />
            <TextBlock Grid.Row="3" Grid.Column="6" Text="{Binding VersionInfo}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="内核版本:" Classes="muted" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding KernelVersion}" />
            <TextBlock Grid.Row="4" Grid.Column="4" Text="构建日期:" Classes="muted" />
            <TextBlock Grid.Row="4" Grid.Column="6" Text="{Binding BuildDate}" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="A/B分区:" Classes="muted" />
            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding SlotSuffix}" />
            <TextBlock Grid.Row="5" Grid.Column="4" Text="CPU厂家:" Classes="muted" />
            <TextBlock Grid.Row="5" Grid.Column="6" Text="{Binding CpuVendor}" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="CPU代号:" Classes="muted" />
            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding SocName}" />
            <TextBlock Grid.Row="6" Grid.Column="4" Text="操作系统:" Classes="muted" />
            <TextBlock Grid.Row="6" Grid.Column="6" Text="{Binding OsName}" />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="SELinux:" Classes="muted" />
            <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding SelinuxState}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 电池 + 存储/内存 -->
      <StackPanel Grid.Column="1" Spacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="电池状态" Classes="h2" Margin="0" />
            <Border BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1.5" CornerRadius="6"
                    Height="26" Margin="6,2,26,2">
              <Grid>
                <Border Background="#EFE9FB" CornerRadius="4,0,0,4" Width="20" HorizontalAlignment="Left" />
                <TextBlock Text="0 ℃" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
              </Grid>
            </Border>
            <TextBlock Text="等待设备连接后显示电量与温度" Classes="muted" Margin="6,0,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="存储与内存" Classes="h2" Margin="0" />
            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="2">
                <ProgressBar Value="0" />
                <TextBlock Text="0.00GB/0GB" Classes="muted" HorizontalAlignment="Center" />
                <TextBlock Text="内部存储" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <ProgressBar Value="0" />
                <TextBlock Text="0GB/0GB" Classes="muted" HorizontalAlignment="Center" />
                <TextBlock Text="运行内存" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">

      <!-- 快捷重启 (upstream: 6 blue buttons, 2 columns) -->
      <Border Grid.Column="0" Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Text="快捷重启" Classes="h2" Margin="0" />
          <Grid ColumnDefinitions="1*,1*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
            <Button Grid.Row="0" Grid.Column="0" Classes="primary" Content="系统" Margin="0,0,0,8"
                    Command="{Binding RebootCommand}" CommandParameter="" />
            <Button Grid.Row="0" Grid.Column="1" Classes="primary" Content="Fastboot" Margin="0,0,0,8"
                    Command="{Binding RebootCommand}" CommandParameter="bootloader" />
            <Button Grid.Row="1" Grid.Column="0" Classes="primary" Content="FastbootD" Margin="0,0,0,8"
                    Command="{Binding RebootCommand}" CommandParameter="fastbootd" />
            <Button Grid.Row="1" Grid.Column="1" Classes="primary" Content="Recovery" Margin="0,0,0,8"
                    Command="{Binding RebootCommand}" CommandParameter="recovery" />
            <Button Grid.Row="2" Grid.Column="0" Classes="dangerSolid" Content="9008(EDL)" Margin="0,0,0,8"
                    Command="{Binding RebootCommand}" CommandParameter="edl" />
            <Button Grid.Row="2" Grid.Column="1" Classes="primary" Content="刷新设备" Margin="0,0,0,8"
                    Command="{Binding RefreshCommand}" />
          </Grid>
          <ComboBox PlaceholderText="更多重启指令" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>

      <!-- 快捷工具 -->
      <Border Grid.Column="1" Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Text="快捷工具" Classes="h2" Margin="0" />
          <Grid ColumnDefinitions="1*,1*" ColumnSpacing="8">
            <Button Grid.Column="0" Classes="primary" Content="无线调试" Margin="0,0,0,8" />
            <Button Grid.Column="1" Classes="primary" Content="切换槽位" Margin="0,0,0,8"
                    Command="{Binding SetSlotCommand}" CommandParameter="a" />
          </Grid>
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="设备检测" VerticalAlignment="Center" FontSize="12" />
              <ToggleSwitch IsChecked="True" />
              <TextBlock Text="多设备" VerticalAlignment="Center" FontSize="12" Margin="12,0,0,0" />
              <ToggleSwitch IsChecked="True" />
            </StackPanel>
            <ComboBox PlaceholderText="选择设备" HorizontalAlignment="Stretch" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 底部链接条 -->
    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
      <Button Classes="footerLink" Content="保存设备信息" />
      <TextBlock Text="|" Foreground="{DynamicResource BorderMutedBrush}" VerticalAlignment="Center" />
      <Button Classes="footerLink" Content="全功能使用教程" />
      <TextBlock Text="|" Foreground="{DynamicResource BorderMutedBrush}" VerticalAlignment="Center" />
      <Button Classes="footerLink" Content="连接指南" />
      <TextBlock Text="|" Foreground="{DynamicResource BorderMutedBrush}" VerticalAlignment="Center" />
      <Button Classes="footerLink" Content="USB3.0补丁" />
    </StackPanel>

  </StackPanel>
</UserControl>
