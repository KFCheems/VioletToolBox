<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             x:Class="VioletToolBox.Linux.Views.OujiaPage"
             x:DataType="vm:OujiaPageViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="欧加线刷 · 全模式工作台" Classes="h1" Margin="0" />
        <TextBlock Text="OPPO / 一加 / realme 全量包与售后包刷写，附带小米官方线刷" Classes="muted" />
      </StackPanel>
    </Grid>

    <Border Classes="panel" MaxWidth="900" HorizontalAlignment="Left">
      <StackPanel Spacing="10">
        <TextBlock Text="全量包模式" FontWeight="Medium" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding PackageDir}" PlaceholderText="解包后的全量包目录" />
          <Button Grid.Column="1" Content="选择目录…" Command="{Binding PickDirCommand}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="模式" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding ModeName}" MinWidth="170" HorizontalAlignment="Left" />
          <Button Grid.Column="2" Content="ARB 检测" Command="{Binding CheckArbCommand}" />
          <Button Grid.Column="3" Classes="primary" Content="⚡ 开始线刷" Command="{Binding StartCommand}" Padding="18,10" />
        </Grid>
        <Border Background="#FDF6EC" CornerRadius="8" Padding="10,8" BorderBrush="{DynamicResource BorderMutedBrush}"
              IsVisible="{Binding ArbInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ArbInfo}" Foreground="#E88B2D" FontSize="12" FontWeight="Medium" />
      </Border>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="停止" Command="{Binding StopCommand}" />
          <TextBlock Text="{Binding Status}" FontSize="12.5" Foreground="#5C5670" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="panel" MaxWidth="900" HorizontalAlignment="Left">
      <StackPanel Spacing="10">
        <TextBlock Text="小米官方线刷（flash_all.sh 原生 Linux 脚本）" FontWeight="Medium" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding XiaomiDir}" PlaceholderText="已解包的小米线刷目录（含 flash_all.sh）" IsReadOnly="True" />
          <Button Grid.Column="1" Content="选择 .tgz 并解包" Command="{Binding PickXiaomiDirCommand}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="脚本" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding XiaomiScripts}" SelectedItem="{Binding XiaomiScript}" MinWidth="240" HorizontalAlignment="Left" />
          <Button Grid.Column="2" Classes="primary" Content="⚡ 执行小米线刷" Command="{Binding RunXiaomiCommand}" Padding="18,10" />
        </Grid>
        <TextBlock Text="{Binding Status}" FontSize="12.5" Foreground="#5C5670" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
