<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             x:Class="VioletToolBox.Linux.Views.BackupPage"
             x:DataType="vm:BackupPageViewModel">
  <StackPanel>
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="备份助手 · 数据守护" Classes="h1" Margin="0" />
        <TextBlock Text="照片、视频与通讯录的设备到本地安全备份" Classes="muted" />
      </StackPanel>
    </Grid>

    <Border Classes="panel" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <RadioButton GroupName="bmode" Content="照片 (DCIM)" IsChecked="{Binding IsPhotos}" />
          <RadioButton GroupName="bmode" Content="视频" IsChecked="{Binding IsVideos}" />
          <RadioButton GroupName="bmode" Content="通讯录 (VCF)" IsChecked="{Binding IsContacts}" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0" Text="{Binding SaveDir}" PlaceholderText="备份保存目录" />
          <Button Grid.Column="1" Content="浏览" Command="{Binding PickDirCommand}" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="开始备份" Command="{Binding BackupCommand}" />
          <TextBlock Text="{Binding Status}" FontSize="13" Foreground="#4E4A5C" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
