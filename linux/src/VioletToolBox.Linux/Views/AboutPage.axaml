<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VioletToolBox.Linux.ViewModels"
             x:Class="VioletToolBox.Linux.Views.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <StackPanel>
    <TextBlock Text="关于" Classes="h1" />
    <Border Classes="card" MaxWidth="860" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding AppVersion}" FontSize="15" FontWeight="Medium" Foreground="#C4B5FD" />
        <TextBlock Text="{Binding Upstream}" Classes="muted" />
        <TextBlock Text="{Binding PortNote}" TextWrapping="Wrap" Foreground="#B7AFCE" FontSize="12.5" />
        <TextBlock Text="{Binding License}" TextWrapping="Wrap" Classes="muted" />
      </StackPanel>
    </Border>
    <Border Classes="card" MaxWidth="860" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="环境检查" FontWeight="Medium" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding Tools}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToolStatus">
              <TextBlock FontSize="12" Margin="0,2" Text="{Binding Display}" Foreground="#B7AFCE" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
