<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VioletToolBox.Linux.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <!-- Primary Violet Palette -->
          <Color x:Key="VioletPrimaryColor">#8B5CF6</Color>
          <Color x:Key="VioletDarkColor">#6D28D9</Color>
          <Color x:Key="VioletLightColor">#A78BFA</Color>
          <Color x:Key="VioletGlowColor">#2E1065</Color>

          <SolidColorBrush x:Key="VioletPrimaryBrush" Color="{StaticResource VioletPrimaryColor}" />
          <SolidColorBrush x:Key="VioletDarkBrush" Color="{StaticResource VioletDarkColor}" />
          <SolidColorBrush x:Key="VioletLightBrush" Color="{StaticResource VioletLightColor}" />
          <SolidColorBrush x:Key="VioletGlowBrush" Color="{StaticResource VioletGlowColor}" />

          <!-- Backgrounds & Surfaces -->
          <Color x:Key="BgDarkest">#0B0912</Color>
          <Color x:Key="BgSidebar">#120F1D</Color>
          <Color x:Key="BgCard">#1A162B</Color>
          <Color x:Key="BgCardHover">#231E3A</Color>
          <Color x:Key="BgInput">#141122</Color>
          <Color x:Key="BorderMuted">#2E274A</Color>
          <Color x:Key="BorderLight">#433870</Color>

          <SolidColorBrush x:Key="BgDarkestBrush" Color="{StaticResource BgDarkest}" />
          <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebar}" />
          <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
          <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHover}" />
          <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInput}" />
          <SolidColorBrush x:Key="BorderMutedBrush" Color="{StaticResource BorderMuted}" />
          <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />

          <!-- Text colors -->
          <Color x:Key="TextHeader">#F3F0FF</Color>
          <Color x:Key="TextBody">#D1C7EE</Color>
          <Color x:Key="TextMuted">#8B80AC</Color>
          <Color x:Key="TextAccent">#C4B5FD</Color>

          <SolidColorBrush x:Key="TextHeaderBrush" Color="{StaticResource TextHeader}" />
          <SolidColorBrush x:Key="TextBodyBrush" Color="{StaticResource TextBody}" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
          <SolidColorBrush x:Key="TextAccentBrush" Color="{StaticResource TextAccent}" />

          <!-- Semantic alerts -->
          <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
          <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
          <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Global typography & controls -->
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Inter, Noto Sans CJK SC, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextHeaderBrush}" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Cards & Panels -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="BoxShadow" Value="0 4 20 #1A000000" />
    </Style>

    <Style Selector="Border.card-subtle">
      <Setter Property="Background" Value="#151224" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#221C38" />
      <Setter Property="Foreground" Value="{DynamicResource TextHeaderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2F274D" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
    </Style>

    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="Button.violet">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#7C3AED" Offset="0.0" />
          <GradientStop Color="#6D28D9" Offset="1.0" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#8B5CF6" />
    </Style>

    <Style Selector="Button.violet:pointerover /template/ ContentPresenter">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#8B5CF6" Offset="0.0" />
          <GradientStop Color="#7C3AED" Offset="1.0" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="BorderBrush" Value="#A78BFA" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#4C1D24" />
      <Setter Property="Foreground" Value="#FCA5A5" />
      <Setter Property="BorderBrush" Value="#7F1D1D" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#7F1D1D" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1933" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
    </Style>

    <!-- Inputs & Combos -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextHeaderBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource VioletPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="{DynamicResource BgInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextHeaderBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Progress Bar -->
    <Style Selector="ProgressBar">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#181326" />
      <Setter Property="Foreground" Value="{DynamicResource VioletPrimaryBrush}" />
      <Setter Property="Height" Value="6" />
    </Style>

    <!-- ListBox -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#29204A" />
      <Setter Property="BorderBrush" Value="{DynamicResource VioletPrimaryBrush}" />
    </Style>

    <!-- ScrollBar -->
    <Style Selector="ScrollBar">
      <Setter Property="AllowAutoHide" Value="True" />
    </Style>
  </Application.Styles>
</Application>
