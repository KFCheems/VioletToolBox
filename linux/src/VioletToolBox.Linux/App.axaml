<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VioletToolBox.Linux.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- Upstream palette (from preview screenshots): white body, purple title bar,
               blue primary buttons, light-gray selected rows with a blue strip. -->
          <Color x:Key="BrandColor">#7B4FD8</Color>
          <Color x:Key="BrandDeepColor">#6A3FCB</Color>
          <Color x:Key="TitleBarColor">#8A63E8</Color>
          <Color x:Key="WindowBgColor">#F3F2F7</Color>
          <Color x:Key="SidebarBgColor">#FFFFFF</Color>
          <Color x:Key="PanelBgColor">#FFFFFF</Color>
          <Color x:Key="PrimaryColor">#4C82F0</Color>
          <Color x:Key="PrimaryPressedColor">#3A6BD8</Color>
          <Color x:Key="RowSelectedColor">#EFEFF6</Color>
          <Color x:Key="StripColor">#4C82F0</Color>
          <Color x:Key="DangerColor">#E8677A</Color>
          <Color x:Key="WarnColor">#F09A4E</Color>
          <Color x:Key="SuccessColor">#34B37E</Color>
          <Color x:Key="BorderMutedColor">#E3E1EC</Color>
          <Color x:Key="InputBorderColor">#C9C6D8</Color>

          <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
          <SolidColorBrush x:Key="BrandDeepBrush" Color="{StaticResource BrandDeepColor}" />
          <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />
          <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
          <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
          <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}" />
          <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
          <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
          <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}" />
          <SolidColorBrush x:Key="StripBrush" Color="{StaticResource StripColor}" />
          <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
          <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
          <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
          <SolidColorBrush x:Key="BorderMutedBrush" Color="{StaticResource BorderMutedColor}" />
          <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Noto Sans CJK SC, Inter, Segoe UI, sans-serif" />
      <Setter Property="Foreground" Value="#2B2833" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#2B2833" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#3E3A4D" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8D88A0" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Upstream "panel": white rounded group box -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Buttons: upstream primary = solid blue, secondary = light lavender -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#EDF0FD" />
      <Setter Property="Foreground" Value="#4C82F0" />
      <Setter Property="BorderBrush" Value="#B9CCF7" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#DFE9FD" />
      <Setter Property="BorderBrush" Value="#8FB4F5" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
    </Style>

    <Style Selector="Button.brand">
      <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.brand:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BrandDeepBrush}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FDF0F2" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="#F3C4CC" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FADEE3" />
    </Style>

    <Style Selector="Button.dangerSolid">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.warn">
      <Setter Property="Background" Value="#FDF3E7" />
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
      <Setter Property="BorderBrush" Value="#F5D5B0" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#2B2833" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#2B2833" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Tables: header strip + zebra-less light rows -->
    <Style Selector="Border.tableHeader">
      <Setter Property="Background" Value="#F0EFF6" />
      <Setter Property="CornerRadius" Value="6,6,0,0" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
      <Setter Property="BorderThickness" Value="1,0,1,1" />
      <Setter Property="CornerRadius" Value="0,0,6,6" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Background" Value="#E7E5F0" />
    </Style>

    <!-- Separator like upstream panel dividers -->
    <Style Selector="Separator">
      <Setter Property="Background" Value="{DynamicResource BorderMutedBrush}" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,8" />
    </Style>
  </Application.Styles>
</Application>
